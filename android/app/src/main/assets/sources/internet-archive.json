{
  "name": "Internet Archive",
  "about": {
    "en": "Scanned public domain books",
    "de": "Gescannte gemeinfreie Bücher",
    "fr": "Livres du domaine public numérisés",
    "es": "Libros de dominio público escaneados"
  },
  "search": {
    "url": "https://archive.org/advancedsearch.php?q=title%3A%28{titleWords}%29%20AND%20creator%3A%28{surname}*%29%20AND%20language%3A%28{language3}%20OR%20{languageName}%20OR%20{language}%29%20AND%20mediatype%3Atexts%20AND%20format%3AEPUB%20AND%20NOT%20access-restricted-item%3Atrue%20AND%20NOT%20collection%3Aopensource&fl%5B%5D=identifier&fl%5B%5D=title&fl%5B%5D=creator&rows=20&output=json",
    "items": { "json": "response.docs" },
    "fields": {
      "title": { "json": "title", "regex": "^(.*?)[\\s;:/,.]*$" },
      "author": {
        "json": "creator",
        "regex": "^(.*?)(?:,\\s*(?:\\d{4}\\??-(?:\\d{4}\\??)?|author|editor|translator|illustrator)\\.?)*$"
      },
      "identifier": { "json": "identifier" }
    }
  },
  "steps": [
    {
      "url": "https://archive.org/metadata/{identifier}/files",
      "fields": {
        "file": {
          "json": "result",
          "regex": "^(?!.*\"private\":\"true\").*\"name\":\"([^\"]+\\.epub)\""
        },
        "size": {
          "json": "result",
          "regex": "^(?!.*\"private\":\"true\")(?=.*\"name\":\"[^\"]+\\.epub\").*\"size\":\"(\\d+)\""
        }
      }
    }
  ],
  "download": "https://archive.org/download/{identifier}/{file}",
  "cover": "https://archive.org/services/img/{identifier}"
}
